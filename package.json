{
  "name": "dsh-phone-notify",
  "version": "0.2.4",
  "description": "Push DeepSeek Harness task events (done / failed / waiting for you) to your phone via any webhook — for when you're away from the computer.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./notify": "./lib/notify.js",
    "./config": "./lib/config.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-phone-notify": "./bin/init.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "init": "node bin/init.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "webhook",
    "push"
  ],
  "license": "MIT",
  "author": "echo-whale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echo-whale/dsh-phone-notify.git"
  },
  "homepage": "https://github.com/echo-whale/dsh-phone-notify#readme",
  "bugs": {
    "url": "https://github.com/echo-whale/dsh-phone-notify/issues"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "plugin": {
      "kind": "host"
    }
  }
}
